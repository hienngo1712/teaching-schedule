# === DATABASE FOR TESTING ===
# BẮT BUỘC: DATABASE_URL phải trỏ endpoint KHÁC với production (khác ep-xxx trong hostname).
# Nếu dùng Neon: tạo branch riêng (Neon Dashboard → Branches → New Branch).
# Endpoint production và test KHÔNG được trùng nhau — setup.ts sẽ block nếu giống nhau.
# Ví dụ Neon test branch: ...@ep-some-other-branch-pooler.neon.tech/neondb
DATABASE_URL="postgresql://teacher:TeachSecure2026@localhost:5432/teaching_schedule_test"
DIRECT_URL="postgresql://teacher:TeachSecure2026@localhost:5432/teaching_schedule_test"

# Các biến khác có thể giữ nguyên hoặc thay đổi tùy nhu cầu test
NEXTAUTH_SECRET="test-secret-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
